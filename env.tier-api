# PMOVES.AI Tier Environment: API
# For API Gateway and REST API services
# Loaded via docker-compose env_file after env.shared

# ============================================================================
# API Tier Configuration
# ============================================================================

TIER=api

# Service limits
MAX_CONCURRENT_REQUESTS=${MAX_CONCURRENT_REQUESTS:-100}
MAX_REQUEST_SIZE_MB=${MAX_REQUEST_SIZE_MB:-10}
REQUEST_TIMEOUT_MS=${REQUEST_TIMEOUT_MS:-30000}

# Rate limiting
RATE_LIMIT_ENABLED=${RATE_LIMIT_ENABLED:-true}
RATE_LIMIT_REQUESTS_PER_MINUTE=${RATE_LIMIT_REQUESTS_PER_MINUTE:-60}
RATE_LIMIT_BURST=${RATE_LIMIT_BURST:-10}

# CORS configuration
# SECURITY: Default to restrictive CORS - override for specific environments
CORS_ORIGINS=${CORS_ORIGINS:-http://localhost:3000,http://localhost:8080}
CORS_ALLOW_CREDENTIALS=${CORS_ALLOW_CREDENTIALS:-false}
CORS_ALLOW_METHODS=${CORS_ALLOW_METHODS:-GET,POST,PUT,DELETE,OPTIONS}
CORS_ALLOW_HEADERS=${CORS_ALLOW_HEADERS:-Authorization,Content-Type,X-API-Key}

# API Documentation
API_DOCS_ENABLED=${API_DOCS_ENABLED:-true}
OPENAPI_URL=${OPENAPI_URL:-/openapi.json}
DOCS_URL=${DOCS_URL:-/docs}
REDOC_URL=${REDOC_URL:-/redoc}

# Response compression
COMPRESSION_ENABLED=${COMPRESSION_ENABLED:-true}
COMPRESSION_LEVEL=${COMPRESSION_LEVEL:-6}
COMPRESSION_MIN_SIZE=${COMPRESSION_MIN_SIZE:-500}

# Security headers
SECURITY_ENABLED=${SECURITY_ENABLED:-true}
SECURITY_FRAMEGUARD=${SECURITY_FRAMEGUARD:-DENY}
SECURITY_HSTS_MAX_AGE=${SECURITY_HSTS_MAX_AGE:-31536000}
